{
  "name": "storybook-preset-inline-svg",
  "version": "2.0.0-rc.0",
  "description": "Storybook preset to load SVG files inline",
  "type": "module",
  "main": "dist",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "engineStrict": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/morganney/storybook-preset-inline-svg.git"
  },
  "bugs": {
    "url": "https://github.com/morganney/storybook-preset-inline-svg/issues"
  },
  "scripts": {
    "build": "babel-dual-package src",
    "prettier": "prettier --write .",
    "prepack": "node --run build"
  },
  "keywords": [
    "storybook",
    "preset",
    "svg",
    "inline"
  ],
  "author": "Morgan Ney <morganney@gmail.com>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "babel-dual-package": "^1.2.1",
    "prettier": "^3.6.2"
  },
  "peerDependencies": {
    "storybook": "^10.0.0-beta.13",
    "svg-inline-loader": "^0.8.2"
  },
  "prettier": {
    "arrowParens": "avoid",
    "printWidth": 90,
    "semi": false,
    "singleQuote": true
  }
}
